# Copy to `.env` in the repo root (engine loads this via dotenvy).
# Never commit `.env` — it holds secrets.

# --- CLOB API (PolyBolt feeds + live order POST L2 auth) ---
# Required for authenticated PolyBolt price streams.
# Required for live trading when configs/default.toml has infra.dry_run = false.
POLY_API_KEY=
POLY_API_SECRET=
POLY_PASSPHRASE=

# --- Wallet (engine only; dashboard never uses these) ---
# Required when infra.dry_run = false (real EIP-712 presign + POST /order).
POLY_PRIVATE_KEY=
# Polymarket trading / funder address (0x…). Alias: POLY_FUNDER_ADDRESS
POLY_ADDRESS=

# --- Optional ---
# RUST_LOG=info
# POLY_FUNDER_ADDRESS=
