# Copy to `.env` in the repo root (engine loads this via dotenvy).
# Never commit `.env` — it holds secrets.

# --- Chainlink Data Streams (when feeds.chainlink_source = data_streams) ---
# From https://data.chain.link/ — API credentials for Data Engine.
CHAINLINK_STREAMS_USER_ID=
CHAINLINK_STREAMS_SECRET=

# --- CLOB API (PolyBolt if chainlink_source=polybolt; live order POST L2 auth) ---
POLY_API_KEY=
POLY_API_SECRET=
POLY_PASSPHRASE=

# --- Wallet (engine only; dashboard never uses these) ---
# Required when infra.dry_run = false (real EIP-712 presign + POST /order).
POLY_PRIVATE_KEY=
POLY_ADDRESS=

# --- Optional ---
# RUST_LOG=info
# POLY_FUNDER_ADDRESS=
# POLY_CHAINLINK_STREAMS_USER_ID=
# POLY_CHAINLINK_STREAMS_SECRET=
